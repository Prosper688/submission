<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f6f8">
    <title>Results | Pioneer University of Science and Innovation</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="portal-layout">
    <%- include("partials/sidebar") %>
    <div class="portal-content">
        <%- include("partials/header", { student }) %>
        <main class="main-content">
            <section class="page-intro"><div><span class="eyebrow">YOUR PROGRESS</span><h2>Academic results</h2><p>Review your published marks and grades.</p></div><span class="page-count"><strong><%= results.length %></strong> result<%= results.length === 1 ? "" : "s" %></span></section>
            <section class="panel results-panel">
                <% if (results.length) { %>
                    <div class="table-scroll"><table class="data-table"><thead><tr><th>COURSE</th><th>COURSE NAME</th><th>TERM</th><th>MARK</th><th>GRADE</th></tr></thead><tbody>
                        <% results.forEach((result) => { %><tr><td><span class="course-code"><%= result.code %></span></td><td><strong><%= result.name %></strong><small class="table-subtext"><%= result.credit_hours %> credits</small></td><td><%= result.semester %><small class="table-subtext"><%= result.year %></small></td><td><%= result.marks === null ? "—" : `${result.marks}%` %></td><td><span class="grade-badge <%= result.grade ? 'grade-published' : 'grade-pending' %>"><%= result.grade || "Pending" %></span></td></tr><% }) %>
                    </tbody></table></div>
                <% } else { %>
                    <div class="empty-state"><span class="empty-icon" aria-hidden="true">▥</span><strong>Your results will appear here</strong><p>There are no published results for your account yet.</p></div>
                <% } %>
            </section>
            <div class="notice-card"><span aria-hidden="true">ⓘ</span><p>Results are published by your faculty. If you think a grade is missing or incorrect, contact your department.</p></div>
        </main>
        <%- include("partials/footer") %>
    </div>
</div>
