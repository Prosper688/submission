<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f6f8">
    <title><%= title %> | Pioneer University of Science and Innovation</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="error-page">
    <main class="error-card">
        <a class="brand" href="/login"><span class="brand-mark" aria-hidden="true">P</span><span class="brand-copy"><strong>PUSI</strong><span>UNIVERSITY PORTAL</span></span></a>
        <span class="error-code"><%= title === "Page not found" ? "404" : title === "Access denied" ? "403" : "!" %></span>
        <h1><%= title %></h1><p><%= message %></p>
        <a class="button button-primary" href="/dashboard">Return to portal <span aria-hidden="true">→</span></a>
    </main>
</body>
</html>
