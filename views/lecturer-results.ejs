<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f6f8">
    <title>Enter results | Pioneer University of Science and Innovation</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="portal-layout">
    <%- include("partials/sidebar") %>
    <div class="portal-content">
        <%- include("partials/header", { student }) %>
        <main class="main-content">
            <% if (flash) { %><div class="alert alert-<%= flash.type %>" role="status"><%= flash.message %></div><% } %>
            <section class="page-intro">
                <div><span class="eyebrow">LECTURER WORKSPACE</span><h2>Enter student results</h2><p>Record marks and grades for students registered in your assigned courses.</p></div>
                <span class="page-count"><strong><%= courses.length %></strong> assigned course<%= courses.length === 1 ? "" : "s" %></span>
            </section>

            <% if (courses.length) { %>
                <form class="search-bar lecturer-course-filter" action="/lecturer/results" method="GET">
                    <label class="search-term lecturer-course-select"><span class="visually-hidden">Course</span><select name="courseId" required><option value="">Choose an assigned course</option><% courses.forEach((course) => { %><option value="<%= course.id %>" <%= selectedCourse && selectedCourse.id === course.id ? "selected" : "" %>><%= course.code %> · <%= course.name %></option><% }) %></select></label>
                    <label class="search-term"><span class="visually-hidden">Semester</span><select name="semester"><% ["Semester 1", "Semester 2", "Summer"].forEach((option) => { %><option <%= semester === option ? "selected" : "" %>><%= option %></option><% }) %></select></label>
                    <label class="search-term"><span class="visually-hidden">Year</span><input type="number" name="year" value="<%= year %>" min="2000" max="2100"></label>
                    <button class="button button-primary" type="submit">Load class list <span aria-hidden="true">→</span></button>
                </form>

                <% if (selectedCourse) { %>
                    <section class="panel lecturer-results-panel">
                        <div class="panel-heading"><div><span class="eyebrow"><%= selectedCourse.code %> · <%= semester %> · <%= year %></span><h2><%= selectedCourse.name %></h2></div><span class="page-count"><strong><%= students.length %></strong> registered student<%= students.length === 1 ? "" : "s" %></span></div>
                        <% if (students.length) { %>
                            <div class="lecturer-student-list">
                                <% students.forEach((record) => { %>
                                    <form action="/lecturer/results" method="POST" class="lecturer-result-row">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="courseId" value="<%= selectedCourse.id %>">
                                        <input type="hidden" name="studentId" value="<%= record.id %>">
                                        <input type="hidden" name="semester" value="<%= semester %>">
                                        <input type="hidden" name="year" value="<%= year %>">
                                        <div class="lecturer-student">
                                            <span class="avatar"><%= record.name.split(" ").map(part => part[0]).slice(0, 2).join("").toUpperCase() %></span>
                                            <span><strong><%= record.name %></strong><small><%= record.student_id %></small></span>
                                        </div>
                                        <label>Mark (%)<input type="number" name="marks" value="<%= record.marks === null ? '' : record.marks %>" min="0" max="100" step="0.1" placeholder="—"></label>
                                        <label>Grade<select name="grade"><option value="">Not graded</option><% ["A", "B", "C", "D", "E", "F"].forEach((grade) => { %><option value="<%= grade %>" <%= record.grade === grade ? "selected" : "" %>><%= grade %></option><% }) %></select></label>
                                        <button class="button button-secondary button-small" type="submit">Save result</button>
                                    </form>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state"><span class="empty-icon" aria-hidden="true">♙</span><strong>No students registered for this course and term</strong><p>Students who register for <%= selectedCourse.code %> in <%= semester %> <%= year %> will appear here.</p></div>
                        <% } %>
                    </section>
                <% } else { %>
                    <section class="panel empty-state"><span class="empty-icon" aria-hidden="true">▥</span><strong>Choose a course to get started</strong><p>Your class list will show the students registered in that course and term.</p></section>
                <% } %>
            <% } else { %>
                <section class="panel empty-state"><span class="empty-icon" aria-hidden="true">▤</span><strong>No courses assigned yet</strong><p>Ask an administrator to assign your courses. Students can only appear on your result list after registering for an assigned course.</p></section>
            <% } %>
        </main>
        <%- include("partials/footer") %>
    </div>
</div>
